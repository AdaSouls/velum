// AdaSouls Velum — credential (POAP) contract for Midnight.
//
// Toolchain: language_version >= 0.23 (pragma below). Built and deployed with
// compactc 0.31.1 (language 0.23.0, compact-runtime 0.16.0) — the version
// pinned in contracts/package.json's `compact` script. Compact changes fast:
// recompiling with another compiler version can change every circuit's keys.
//
// ── Documentation convention ──────────────────────────────────────────────────
// Compact has no NatSpec-style standard, so this file uses its own tags. They
// sit directly above the element they describe, after any free-form rationale.
//
//   @ledger     What the field stores and which circuits write it. Every
//               `export ledger` field is PUBLIC: readable by anyone on-chain.
//   @witness    What private data the client supplies.
//   @source     Where the client gets it (private state, user input).
//   @trust      What a malicious witness implementation could do. Witnesses
//               run in the caller's own TypeScript, so they are NOT trusted.
//   @circuit    What the circuit does and who is meant to call it.
//   @param      One per argument. Arguments are prover-chosen private inputs
//               until disclosed or constrained against ledger state.
//   @returns    Return value, if any.
//   @auth       How the caller is authorized (there is no msg.sender).
//   @asserts    What must hold, i.e. what makes the transaction fail.
//   @writes     Ledger fields modified ("none" for a pure check).
//   @discloses  Every value that becomes public, and why that is acceptable.
//   @private    What stays inside the proof and never reaches the chain.
//
// Longer explanations live in docs/01-contract/.

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ── Types ─────────────────────────────────────────────────────────────────────

export struct EventRecord {
  maxSupply: Uint<64>,
  minted: Uint<64>,
  expiration: Uint<64>,
  organizer: Bytes<32>, // issuer public key that owns this event
  isActive: Boolean,
  isPublicMint: Boolean,
  // URI to off-chain JSON (name/description/image/…), e.g. "ipfs://<CID>". Shared
  // by every token minted for this event — see tokenMetadataURI below for the
  // per-token analogue.
  metadataURI: Opaque<"string">,
  // Commitment to a private-fields digest (see computePrivateMetadataCommit /
  // revealPrivateMetadata below). All-zero Bytes<32> means "no private part".
  privateMetadataCommit: Bytes<32>,
  // Merkle root over independently-committed private ATTRIBUTES (e.g.
  // location, category, capacity-tier), each a leaf computed by
  // attribute_leaf_hash/computeAttributeLeaf below. Unlike
  // privateMetadataCommit (one blob, reveal-all-or-nothing), this lets the
  // organizer prove or reveal ONE field at a time — see
  // proveAttributeMembership. All-zero Bytes<32> means "no attributes
  // committed for this event".
  privateAttributesRoot: Bytes<32>,
}

export struct IssuerRecord {
  organizerPk: Bytes<32>,
  isActive: Boolean,
}

// A verifier-published question: "does this event's <fieldId> attribute
// belong to the set rooted at <setRoot>?" Published on-chain by the
// verifier BEFORE a holder can prove against it — see
// publishDisclosureRequest / proveAttributeMembership. Pinning this in
// ledger state (instead of letting the prover supply setRoot themselves)
// is what makes the resulting proof mean anything: a caller-supplied root
// is trivially satisfiable for any value.
//
// recipient addresses the request to ONE holder: the holder pseudonym
// (getHolderPk under the event's issuer — the tokenOwner value) that must
// answer it. All-zero means "open": any holder of the event may answer.
// Pinned here for the same reason as setRoot — the holder-side proofs
// compare it against the pseudonym rebuilt from the prover's own secret
// key, so nobody else can answer in the recipient's place (see
// assert_addressed_to).
export struct DisclosureRequest {
  verifier: Bytes<32>,
  eventId: Bytes<32>,
  fieldId: Bytes<32>,
  setRoot: Bytes<32>,
  recipient: Bytes<32>,
}

// ── Public Ledger ─────────────────────────────────────────────────────────────
// Everything in this section is PUBLIC, visible on-chain to anyone. Nothing
// secret may ever be stored here in the clear — only identifiers, hashes and
// commitments. See docs/01-contract/data-privacy.md for the full map.

// @ledger Number of tokens ever minted; also the next tokenId. Never
//         decremented (burns don't reduce it). Written by: claim, mintTo.
export ledger totalSupply: Counter;

// tokenId → owner public key (a per-issuer holder pseudonym — see holder_pk)
// @ledger Set once at mint and never changed (there is no transfer circuit).
//         Written by: claim, mintTo.
export ledger tokenOwner: Map<Uint<64>, Bytes<32>>;

// tokenId → the event this token was minted for. A token maps to exactly one
// event — every claim mints a brand-new token, there is no "update an
// existing token across events" path anymore (see claim()).
// @ledger Written by: claim, mintTo.
export ledger tokenEvent: Map<Uint<64>, Bytes<32>>;

// tokenId → issuerId (organizer pk) that this token belongs to
// @ledger Written by: claim, mintTo.
export ledger tokenIssuer: Map<Uint<64>, Bytes<32>>;

// URI to off-chain JSON for this specific token. Defaults to the event's own
// metadataURI at mint time (claim()), or can be set independently per
// recipient by the organizer (mintTo()).
// @ledger The URI and whatever it points to are public. Written by: claim,
//         mintTo.
export ledger tokenMetadataURI: Map<Uint<64>, Opaque<"string">>;

// Commitment to a per-token private-fields digest — same commit/reveal
// mechanism as the event-level one, but for something specific to this one
// holder (e.g. a hidden edition number, a prize tier revealed at a draw).
// All-zero Bytes<32> means "no private part".
// @ledger Only the commitment is public; the committed value stays hidden
//         until revealPrivateTokenMetadata. Written by: claim, mintTo.
export ledger tokenPrivateMetadataCommit: Map<Uint<64>, Bytes<32>>;

// tokenId → revealed private-metadata digest, once someone has proven it
// matches tokenPrivateMetadataCommit. Public once revealed, same reasoning
// as eventRevealedMetadata below.
// @ledger Written by: revealPrivateTokenMetadata.
export ledger tokenRevealedMetadata: Map<Uint<64>, Bytes<32>>;

// holder_event_key(ownerPk, eventId) → tokenId. Public index preventing the
// same wallet from claiming the same event twice (self-service or
// push-minted) — does NOT limit a wallet to one token per issuer anymore.
// @ledger The key is a hash of two public values, so anyone can recompute it.
//         Written by: claim, mintTo (insert), burn (remove, self-burn only).
export ledger eventHolderToken: Map<Bytes<32>, Uint<64>>;

// eventId → event metadata
// @ledger Every EventRecord field is public, including the organizer's key
//         and the two commitments. Written by: createEvent, deactivateEvent,
//         reactivateEvent, claim, mintTo (minted counter).
export ledger events: Map<Bytes<32>, EventRecord>;

// eventId → revealed private-metadata digest, once someone has proven it
// matches the event's privateMetadataCommit. Public once revealed by
// design — the point of commit-reveal is that content becomes public data
// at reveal time; only the *timing* of disclosure was ever private.
// @ledger Written by: revealPrivateMetadata.
export ledger eventRevealedMetadata: Map<Bytes<32>, Bytes<32>>;

// issuerId (organizer pk) → issuer metadata
// @ledger Verified-issuer registry and blocklist in one (isActive == false
//         means blocked). Written by: registerIssuer, deactivateIssuer.
export ledger issuers: Map<Bytes<32>, IssuerRecord>;

// tokenId → burned flag (true = burned)
// @ledger Entries are only ever added. Written by: burn.
export ledger burnedTokens: Map<Uint<64>, Boolean>;

// Nullifiers spent by proveAttributeMembershipOnce — guards single-use
// selective-disclosure proofs (e.g. "redeem a perk once for proving X")
// against replay, without revealing which wallet the disclosure was
// about (see disclosure_nullifier). Most disclosures should use the
// stateless proveAttributeMembership instead and never touch this set —
// only use the Once variant when a disclosure must provably happen at
// most once. A Set, not a Map<_,Boolean>: membership is all that's ever
// checked, so there's no second dimension worth paying ledger bytes for.
// @ledger Each entry is a hash of (secret key, requestId): public, but not
//         linkable to a wallet or to that wallet's other nullifiers.
//         Written by: proveAttributeMembershipOnce.
export ledger usedDisclosures: Set<Bytes<32>>;

// requestId → the pinned question a verifier published. Reading this via
// lookup() is what makes eventId/fieldId/setRoot actually public and
// checkable in proveAttributeMembership, instead of trusting whatever the
// prover claims — see DisclosureRequest and publishDisclosureRequest.
// @ledger Immutable once published; the verifier's key and the recipient
//         pseudonym (if any) are public too. Written by:
//         publishDisclosureRequest.
export ledger disclosureRequests: Map<Bytes<32>, DisclosureRequest>;

// Credential commitment tree — the anonymous counterpart to tokenOwner.
// The leaf at index tokenId is credential_leaf(eventId, holderPk,
// credAttrRoot), written at mint time. proveEventAttendance /
// proveCredentialAttribute prove knowledge of a live leaf via a Merkle
// path, so the proof reveals only the tree root — not which token, which
// holder pseudonym, or which attributes. A plain tokenId-keyed check
// (like proveTokenOwnership) can't do that: every Map read puts its key in
// the public transcript.
//
// Historic, so a path built against a slightly older root still verifies
// after unrelated mints land in between. burn() overwrites the leaf AND
// calls resetHistory() — without the reset, a revoked credential could
// keep proving against any pre-revocation root forever.
//
// Depth 20 → at most 2^20 = 1048576 tokens (tokenId is used as the leaf
// index; mintTokenTo asserts the bound).
// @ledger Leaf hashes and the root history are public; what stays private is
//         WHICH leaf an anonymous proof was about. Written by: claim, mintTo
//         (insert leaf), burn (clear leaf, reset root history).
export ledger credentials: HistoricMerkleTree<20, Bytes<32>>;

// tokenId → commitment to the holder's off-chain update request: the
// holder asks the token's issuer to re-issue the credential, typically
// because an identity document behind one of its attributes changed (see
// computeIdentityValue). The request itself (which document, the new
// number) travels off-chain, encrypted to the issuer; this entry is what
// lets the issuer trust that envelope came from the token's holder — the
// envelope must hash to the stored commitment, and only the holder can
// write it here. Removed when the issuer dismisses it or when the token is
// burned (the re-issue path: burn, then mintTo the updated credential).
// @ledger Public: that a token's holder asked for an update, and when.
//         Never the document data. Written by: requestCredentialUpdate
//         (insert), dismissCredentialUpdate and burn (remove).
export ledger credentialUpdateRequests: Map<Uint<64>, Bytes<32>>;

// Contract-level pause flag
// @ledger Written by: constructor, pause, unpause.
export ledger isPaused: Boolean;

// Admin public key — set once at deployment. sealed: the compiler rejects
// any write to this ledger field outside the constructor, converting the
// contract's most security-critical invariant (admin identity never
// changes) from a review obligation into a compile-time guarantee.
// @ledger derive_pk of the deployer's secret key. Written by: constructor.
export sealed ledger adminPk: Bytes<32>;

// @circuit   Runs once, at deployment. Makes the deployer the admin.
// @writes    adminPk, isPaused.
// @discloses derive_pk(local_sk()) — the admin's public key, public by
//            design. The secret key itself never leaves the proof.
constructor() {
  adminPk = disclose(derive_pk(local_sk()));
  isPaused = false;
}

// ── Witnesses ─────────────────────────────────────────────────────────────────
// Witnesses are implemented by the CLIENT (contracts/src/witnesses.ts here,
// src/midnight/witnesses.ts in the frontend). The contract can't see how they
// are implemented, so nothing a witness returns is trusted until an assert
// ties it to ledger state.

// @witness The caller's 32-byte secret key for this contract. Every identity
//          in the contract (admin, issuer/organizer, verifier, holder
//          pseudonyms, nullifiers) is a domain-separated hash of it.
// @source  The client's private state (a random key generated once per
//          wallet in the frontend; derived from the wallet seed in scripts/).
// @trust   The caller may return ANY key. That only lets them act as the
//          identity that key hashes to, so authorization comes down to
//          knowing the secret — but it also means one person can use many
//          keys (many unlinkable pseudonyms). See the maxSupply note in
//          mintTokenTo and the organizer check in claim.
witness local_sk(): Bytes<32>;

// Persists a newly-claimed token to client-side state, keyed by event.
// isSoulbound is intentionally NOT enforced on-chain: soulbound status is
// meant to live in private state by design (see product-vision.md — this
// is the specific privacy improvement over the original Milkomeda design,
// where soulbound status was publicly visible). There is also no transfer
// circuit in this contract, so every token is de facto non-transferable
// regardless of this flag; it exists for the client's own bookkeeping
// (e.g. UI treatment), not as an enforced guarantee. A malicious witness
// implementation could record the wrong value for its own private
// state — that only misleads the wallet that did it, not anyone else.
// @witness Side-effect only: lets the client save the token it just claimed.
//          Returns nothing, so it can't influence the circuit.
// @source  Writes to the client's private state (the `tokens` cache).
// @trust   None needed: a wrong or missing implementation only corrupts
//          the caller's own local cache. Called by: claim.
witness store_token(
          tokenId: Uint<64>,
          issuerId: Bytes<32>,
          eventId: Bytes<32>,
          isSoulbound: Boolean
          ): [];

// ── Internal Helpers ──────────────────────────────────────────────────────────

circuit derive_pk(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "adasouls:pk:v1:"), sk]);
}

circuit caller_pk(): Bytes<32> {
  // The derived public key is inherently public in this contract: it is stored
  // on-chain as a token owner, the admin key, and issuer identifiers. Disclosing
  // it here reflects that design and covers all downstream uses.
  return disclose(derive_pk(local_sk()));
}

// Per-issuer holder pseudonym. Unlike caller_pk() (one stable identity used
// for admin/issuer/organizer roles everywhere), this derives a DIFFERENT,
// uncorrelatable value per issuer for the same wallet — so a chain observer
// can't tell that the wallet holding a POAP from Issuer A is the same wallet
// holding one from Issuer B. Tokens from the SAME issuer still share this
// value on purpose — that's the deliberate, minimal amount of correlation
// this design keeps (see eventHolderToken).
circuit holder_pk(issuerId: Bytes<32>): Bytes<32> {
  return disclose(persistentHash<Vector<3, Bytes<32>>>(
           [pad(32, "adasouls:holder-pk:v1:"), local_sk(), issuerId]
           ));
}

// Same value as holder_pk, but NOT disclosed. Used only inside the
// anonymous credential proofs, where the pseudonym must never reach the
// public transcript — it only feeds a hidden Merkle leaf. Keeping it
// undisclosed makes the compiler reject any accidental ledger use of it.
circuit holder_secret_pk(issuerId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
           [pad(32, "adasouls:holder-pk:v1:"), local_sk(), issuerId]
           );
}

// Leaf of the credentials tree. Binds a credential to its event, to the
// holder's per-issuer pseudonym (so only the holder's sk can use it) and
// to that holder's own private attribute root (all-zero if none — the
// claim() case). No extra salt needed: the leaf is never revealed by a
// proof, and a non-zero credAttrRoot is already hiding (its leaves are
// persistentCommit openings).
circuit credential_leaf(eventId: Bytes<32>, holderPk: Bytes<32>, credAttrRoot: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
           [pad(32, "adasouls:cred-leaf:v1:"), eventId, holderPk, credAttrRoot]
           );
}

// Leaf of a per-credential attribute tree (the tree whose root is
// credAttrRoot). Unlike attribute_leaf_hash, no eventId here: the binding
// to event and holder happens one level up, in credential_leaf.
circuit credential_attr_leaf(fieldId: Bytes<32>, value: Bytes<32>, rand: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
           [pad(32, "adasouls:cred-attr:v1:"), fieldId, persistentCommit<Bytes<32>>(value, rand)]
           );
}

// Public-ledger key for the (holder, event) → token index. Prevents a wallet
// from claiming the same event twice, whether via claim() or mintTo().
circuit holder_event_key(holderPk: Bytes<32>, eventId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
           [pad(32, "adasouls:holder-event:v1:"),
            persistentHash<Vector<2, Bytes<32>>>([holderPk, eventId])]
           );
}

circuit is_admin(): Boolean {
  return adminPk == caller_pk();
}

// Derives an eventId from the organizer's own identity + a label they
// choose, instead of letting the caller pick a raw eventId directly.
// Fixes a confirmed vulnerability (event-ID squatting): with a
// caller-chosen eventId and no other gate, whoever calls createEvent
// first for a given id permanently becomes its organizer — an attacker
// who front-runs a well-known id locks out the real organizer forever
// (deactivateEvent doesn't free it either) and can mint counterfeit
// tokens under it. Scoping the id to hash(organizer, label) means an
// attacker can only squat their OWN namespace; no coordination between
// organizers is required to avoid collisions, and createEvent stays
// fully permissionless — this is not a registration gate.
circuit event_key(organizer: Bytes<32>, label: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
           [pad(32, "adasouls:event:v1:"), organizer, label]
           );
}

// Pure off-chain helper: predict the eventId createEvent(label, ...) will
// assign for a given organizer, before submitting the transaction (e.g.
// so a frontend can show/link the id immediately, or so tests can locate
// the event afterward). organizer is not secret — it's derive_pk(sk),
// already public everywhere else in this contract.
// @circuit   Pure helper, runs locally: no proof, no transaction.
// @param     organizer  The organizer's public key (getCallerPk).
// @param     label      The label that will be passed to createEvent.
// @returns   The eventId createEvent will assign.
// @writes    none.
// @discloses organizer, label — both already public inputs; the disclose()
//            calls only let the result leave the circuit.
export circuit computeEventId(organizer: Bytes<32>, label: Bytes<32>): Bytes<32> {
  return event_key(disclose(organizer), disclose(label));
}

// ── Pause / Unpause ───────────────────────────────────────────────────────────
// While paused, every state-changing circuit fails. The read-only proofs
// (proveTokenOwnership, proveEventAttendance, proveCredentialAttribute,
// proveAttributeMembership) keep working.

// @circuit   Emergency stop.
// @auth      Admin: derive_pk(local_sk()) must equal adminPk.
// @asserts   Caller is the admin.
// @writes    isPaused = true.
// @discloses Nothing new — the admin key compared against is already public.
export circuit pause(): [] {
  assert(is_admin(), "Only admin can pause");
  isPaused = true;
}

// @circuit   Lifts the pause.
// @auth      Admin.
// @asserts   Caller is the admin.
// @writes    isPaused = false.
// @discloses Nothing new.
export circuit unpause(): [] {
  assert(is_admin(), "Only admin can unpause");
  isPaused = false;
}

// ── Issuer Management ─────────────────────────────────────────────────────────
// Anyone can create events (see createEvent) — registration here is NOT a
// gate. It's an optional "verified organizer" signal an admin can curate;
// the frontend may choose to show a checkmark for registered, active issuers.
// The same map doubles as the moderation blocklist: an entry with
// isActive == false is a blocked issuer (see deactivateIssuer), whether or
// not it was ever registered.

// Register an issuer by their Midnight public key. Admin-only.
// @circuit   Marks an organizer as verified.
// @param     issuerPk  The organizer's public key (their getCallerPk).
// @auth      Admin.
// @asserts   Not paused; caller is the admin; no entry exists yet for this
//            key (so a blocked key can't be re-registered).
// @writes    issuers[issuerPk] = { isActive: true }.
// @discloses issuerPk — it becomes a public ledger key.
export circuit registerIssuer(issuerPk: Bytes<32>): [] {
  const pk = disclose(issuerPk);
  assert(!isPaused, "Contract is paused");
  assert(is_admin(), "Only admin can register issuers");
  assert(!issuers.member(pk), "Issuer already registered");
  const issuer = IssuerRecord { organizerPk: pk, isActive: true };
  issuers.insert(pk, issuer);
}

// Deactivate (block) an issuer. Admin-only. Works on ANY key, registered or
// not: an unknown key gets an inactive entry, which is what blocks it —
// otherwise the permissionless issuers this is meant to stop could never be
// blocked. A blocked issuer can't create events (createEvent) and no new
// tokens can be minted under their existing events (mintTokenTo). There is
// no unblock; a blocked key also can't be (re-)registered.
// @circuit   Blocks an organizer, permanently.
// @param     issuerPk  The public key to block.
// @auth      Admin.
// @asserts   Not paused; caller is the admin.
// @writes    issuers[issuerPk] = { isActive: false }.
// @discloses issuerPk — it becomes a public ledger key.
export circuit deactivateIssuer(issuerPk: Bytes<32>): [] {
  const pk = disclose(issuerPk);
  assert(!isPaused, "Contract is paused");
  assert(is_admin(), "Only admin can deactivate issuers");
  const updated = IssuerRecord { organizerPk: pk, isActive: false };
  issuers.insert(pk, updated);
}

// ── Event Management ──────────────────────────────────────────────────────────

// Create an event. Permissionless: callable by anyone the admin hasn't
// blocked. The caller's own public key becomes the issuerId for this event —
// no registration or admin approval required. Admin retains moderation
// overrides via deactivateEvent (sticky — see reactivateEvent),
// deactivateIssuer and pause; the issuer registry above is opt-in metadata,
// not a gate.
//
// `label` replaces what used to be a caller-chosen eventId directly — the
// actual on-chain eventId is derived as event_key(caller_pk(), label) and
// returned, so the same label from two different organizers (or the same
// organizer reusing a label after a mistake) can never collide or be
// squatted. Use computeEventId to predict it off-chain before submitting.
//
// privateMetadataCommit lets the organizer keep part of the event's
// metadata hidden from everyone except whoever they later share the
// (value, rand) opening with — see computePrivateMetadataCommit and
// revealPrivateMetadata. Pass an all-zero Bytes<32> for a fully public
// event with no private part.
//
// privateAttributesRoot is the analogous commitment for independently
// provable/revealable FIELDS (see computeAttributeLeaf and
// proveAttributeMembership) — pass an all-zero Bytes<32> if the event has
// no such structured attributes.
// @circuit   Creates an event owned by the caller.
// @param     label                  Organizer-chosen label, hashed into the id.
// @param     maxSupply              Total mints allowed; 0 = unlimited.
// @param     expiration             Block time after which minting stops;
//                                   0 = never.
// @param     isPublicMint           true = anyone may claim(); false = only
//                                   mintTo().
// @param     metadataURI            Public off-chain metadata.
// @param     privateMetadataCommit  Commitment to hidden metadata, or zero.
// @param     privateAttributesRoot  Root of the hidden attribute tree, or zero.
// @returns   The derived eventId.
// @auth      Anyone whose key is not blocked in `issuers`.
// @asserts   Not paused; caller not deactivated; event id not already used.
// @writes    events[eventId].
// @discloses Every argument, plus the caller's public key (stored as
//            organizer) — an event is public by definition.
// @private   The caller's secret key, and whatever the two commitments hide.
export circuit createEvent(
                 label: Bytes<32>,
                 maxSupply: Uint<64>,
                 expiration: Uint<64>,
                 isPublicMint: Boolean,
                 metadataURI: Opaque<"string">,
                 privateMetadataCommit: Bytes<32>,
                 privateAttributesRoot: Bytes<32>
                 ): Bytes<32> {
  assert(!isPaused, "Contract is paused");
  const lbl = disclose(label);
  const maxS = disclose(maxSupply);
  const exp = disclose(expiration);
  const pubMint = disclose(isPublicMint);
  const metaURI = disclose(metadataURI);
  const privCommit = disclose(privateMetadataCommit);
  const attrRoot = disclose(privateAttributesRoot);
  const issuerId = caller_pk();
  assert(!issuers.member(issuerId) || issuers.lookup(issuerId).isActive,
         "Issuer is deactivated"
         );
  const evId = event_key(issuerId, lbl);
  assert(!events.member(evId), "Event already exists");

  const ev = EventRecord { maxSupply: maxS,
                           minted: 0 as Uint<64>,
                           expiration: exp,
                           organizer: issuerId,
                           isActive: true,
                           isPublicMint: pubMint,
                           metadataURI: metaURI,
                           privateMetadataCommit: privCommit,
                           privateAttributesRoot: attrRoot };
  events.insert(evId, ev);
  return evId;
}

// Deactivate an event. Admin or the event's own organizer.
// @circuit   Stops new mints for an event. Existing tokens are unaffected.
// @param     eventId  The event to deactivate.
// @auth      Admin, or the event's organizer.
// @asserts   Not paused; event exists; caller is admin or organizer.
// @writes    events[eventId].isActive = false.
// @discloses eventId (ledger key). Not which of the two roles called.
export circuit deactivateEvent(eventId: Bytes<32>): [] {
  const evId = disclose(eventId);
  assert(!isPaused, "Contract is paused");
  assert(events.member(evId), "Event does not exist");
  const ev = events.lookup(evId);
  assert(is_admin() || ev.organizer == caller_pk(), "Not authorized");
  const updated = EventRecord { maxSupply: ev.maxSupply,
                                minted: ev.minted,
                                expiration: ev.expiration,
                                organizer: ev.organizer,
                                isActive: false,
                                isPublicMint: ev.isPublicMint,
                                metadataURI: ev.metadataURI,
                                privateMetadataCommit: ev.privateMetadataCommit,
                                privateAttributesRoot: ev.privateAttributesRoot };
  events.insert(evId, updated);
}

// Reactivate a previously-deactivated event. Admin-only — narrower than
// deactivateEvent on purpose: if the organizer could reactivate, an admin
// takedown of an illegal or abusive event could be undone by the very
// organizer it targets. An organizer who deactivated their own event by
// mistake asks the admin. Every other field is carried forward unchanged.
// @circuit   Re-enables minting for a deactivated event.
// @param     eventId  The event to reactivate.
// @auth      Admin only.
// @asserts   Not paused; event exists; caller is the admin.
// @writes    events[eventId].isActive = true.
// @discloses eventId (ledger key).
export circuit reactivateEvent(eventId: Bytes<32>): [] {
  const evId = disclose(eventId);
  assert(!isPaused, "Contract is paused");
  assert(events.member(evId), "Event does not exist");
  const ev = events.lookup(evId);
  assert(is_admin(), "Only admin can reactivate events");
  const updated = EventRecord { maxSupply: ev.maxSupply,
                                minted: ev.minted,
                                expiration: ev.expiration,
                                organizer: ev.organizer,
                                isActive: true,
                                isPublicMint: ev.isPublicMint,
                                metadataURI: ev.metadataURI,
                                privateMetadataCommit: ev.privateMetadataCommit,
                                privateAttributesRoot: ev.privateAttributesRoot };
  events.insert(evId, updated);
}

// ── Token: Mint (shared internal core) ────────────────────────────────────────

// Shared by claim() and mintTo(): every event claim mints a brand-new
// token — there is no "reuse the same token across events from this
// issuer" path anymore (that used to exist purely to save mint costs on
// chains where minting was expensive; Midnight's cost model doesn't force
// that tradeoff, and reusing one token made per-token metadata ambiguous).
// Caller-specific checks (isPublicMint for self-service, organizer/admin
// auth for push-mint) happen in claim()/mintTo() before calling this.
circuit mintTokenTo(
          pk: Bytes<32>,
          eventId: Bytes<32>,
          ev: EventRecord,
          tokenMetaURI: Opaque<"string">,
          tokenPrivCommit: Bytes<32>,
          credAttrRoot: Bytes<32>,
          reissueRevoked: Boolean
          ): Uint<64> {
  assert(ev.isActive, "Event is not active");
  assert(ev.expiration == 0 as Uint<64> || blockTimeLt(ev.expiration),
         "Event has expired"
         );
  // NOTE: this is a total-mint cap, not a distinct-recipient cap. A wallet
  // can present a fresh, unlinkable holder_pk per attempt (see holder_pk),
  // so maxSupply bounds how many tokens an event can ever produce, not how
  // many different people can hold one. Sybil resistance for "one per
  // person" needs an out-of-band claim channel (single-use codes,
  // organizer push-mint via mintTo) — it isn't and can't be a property of
  // this on-chain check alone.
  assert(ev.maxSupply == 0 as Uint<64> || ev.minted < ev.maxSupply,
         "Event has reached maximum supply"
         );
  // A deactivated (blocked) issuer — registered or not, see deactivateIssuer
  // — can no longer have new tokens minted under their events, self-service
  // claim or organizer push-mint alike. Issuers with no entry are unaffected
  // (registration remains opt-in metadata, not a gate).
  assert(!issuers.member(ev.organizer) || issuers.lookup(ev.organizer).isActive,
         "Issuer is deactivated"
         );

  // The (holder, event) slot is taken while it points at a token. A
  // self-burn removes it (see burn); an issuer/admin revocation leaves it
  // pointing at the burned token, which still blocks the holder's own
  // claim() but lets mintTo() (reissueRevoked) issue a replacement.
  const key = holder_event_key(pk, eventId);
  if (eventHolderToken.member(key)) {
    assert(reissueRevoked && burnedTokens.member(eventHolderToken.lookup(key)),
           "Wallet already claimed this event"
           );
  }

  const tokenId = totalSupply.read();

  totalSupply.increment(1);
  tokenOwner.insert(tokenId, pk);
  tokenEvent.insert(tokenId, eventId);
  tokenIssuer.insert(tokenId, ev.organizer);
  tokenMetadataURI.insert(tokenId, tokenMetaURI);
  tokenPrivateMetadataCommit.insert(tokenId, tokenPrivCommit);
  eventHolderToken.insert(key, tokenId);
  // Leaf index == tokenId so burn() can overwrite exactly this leaf.
  assert(tokenId < 1048576 as Uint<64>, "Credential tree is full");
  credentials.insertIndex(credential_leaf(eventId, pk, credAttrRoot), tokenId);

  const updatedEv =
          EventRecord { maxSupply: ev.maxSupply,
                        minted: (ev.minted + 1) as Uint<64>,
                        expiration: ev.expiration,
                        organizer: ev.organizer,
                        isActive: ev.isActive,
                        isPublicMint: ev.isPublicMint,
                        metadataURI: ev.metadataURI,
                        privateMetadataCommit: ev.privateMetadataCommit,
                        privateAttributesRoot: ev.privateAttributesRoot };
  events.insert(eventId, updatedEv);

  return tokenId;
}

// ── Token: Claim (exported, self-service) ────────────────────────────────────

// Mints a fresh token to the caller for this event. The token's metadata
// (public URI + private commitment) is inherited from the event's own —
// use mintTo() if an organizer wants to push a personalized token instead.
// The event's own organizer can't claim it (e.g. follow their own
// subscription). This only stops the organizer's own key: the check runs
// in-circuit and publishes nothing, so a second wallet can't be detected.
// @circuit   Self-service mint of one token of a public event to the caller.
// @param     eventId      The event to claim.
// @param     isSoulbound  Client-side flag, handed to store_token only. Not
//                         enforced and not written to the ledger.
// @auth      Anyone except the event's own organizer key.
// @asserts   Not paused; event exists, is public-mint, active, not expired,
//            under maxSupply; issuer not blocked; caller is not the
//            organizer; this holder pseudonym has no token for the event.
// @writes    totalSupply, tokenOwner, tokenEvent, tokenIssuer,
//            tokenMetadataURI, tokenPrivateMetadataCommit, eventHolderToken,
//            credentials (new leaf), events[eventId].minted.
// @discloses eventId; the caller's holder pseudonym for this issuer (becomes
//            tokenOwner) — minting is public by design.
// @private   The secret key, and so the link between this pseudonym and the
//            caller's pseudonyms under other issuers.
export circuit claim(eventId: Bytes<32>, isSoulbound: Boolean): [] {
  assert(!isPaused, "Contract is paused");
  const evId = disclose(eventId);
  const sb = disclose(isSoulbound);
  assert(events.member(evId), "Event does not exist");
  const ev = events.lookup(evId);
  assert(ev.isPublicMint, "Event requires organizer to mint");
  assert(caller_pk() != ev.organizer, "Organizer cannot claim their own event");

  const pk = holder_pk(ev.organizer);
  // Self-service claims carry no per-holder attributes (nobody attests
  // them) — their credential leaf just proves membership in the event.
  const tokenId = mintTokenTo(pk, evId, ev, ev.metadataURI, ev.privateMetadataCommit, default<Bytes<32>>, false);
  store_token(tokenId, ev.organizer, evId, sb);
}

// ── Token: Push Mint (organizer-initiated) ───────────────────────────────────

// Mint directly to a recipient's public key, with metadata the organizer
// chooses for that specific token (pass ev.metadataURI / an all-zero
// Bytes<32> to just mirror the event's own public/private metadata).
// Callable by admin or the event's own organizer. Never touches the
// recipient's private state — the caller proving this transaction is the
// organizer, not the recipient.
//
// Also re-issues to a recipient whose token for this event was revoked
// (burned by the issuer or admin): the new token takes over the slot.
// The caller can't mint to their own holder pseudonym for this event's
// issuer — the push-mint counterpart of claim()'s organizer check.
//
// credentialAttributesRoot is the root of THIS recipient's private
// attribute tree (leaves from computeCredentialAttrLeaf) — data unique to
// this credential that the holder can later prove predicates about,
// anonymously, via proveCredentialAttribute. The organizer must hand the
// recipient the openings (fieldId, value, rand per leaf) off-chain. Pass
// an all-zero Bytes<32> for a credential with no private attributes.
// Only the resulting credential leaf is written on-chain; the root itself
// never appears in a ledger operation.
// @circuit   Organizer push-mint, and re-issue after a revocation.
// @param     eventId                     The event to mint for.
// @param     recipientPk                 The recipient's holder pseudonym for
//                                        this issuer (their getHolderPk) —
//                                        NOT their getCallerPk.
// @param     tokenMetadataURI            Public metadata for this token.
// @param     tokenPrivateMetadataCommit  Commitment to hidden per-token
//                                        metadata, or zero.
// @param     credentialAttributesRoot    Root of this recipient's private
//                                        attribute tree, or zero.
// @auth      Admin, or the event's organizer.
// @asserts   Not paused; event exists, active, not expired, under maxSupply;
//            issuer not blocked; caller is admin or organizer; recipient is
//            not the caller's own pseudonym; recipient has no live token for
//            the event (a revoked one may be replaced).
// @writes    Same fields as claim.
// @discloses eventId, recipientPk, tokenMetadataURI,
//            tokenPrivateMetadataCommit — all stored on the ledger.
//            credentialAttributesRoot only reaches the chain hashed inside
//            the credential leaf. Not which of the two roles called.
// @private   The attribute values behind credentialAttributesRoot.
export circuit mintTo(
                 eventId: Bytes<32>,
                 recipientPk: Bytes<32>,
                 tokenMetadataURI: Opaque<"string">,
                 tokenPrivateMetadataCommit: Bytes<32>,
                 credentialAttributesRoot: Bytes<32>
                 ): [] {
  const evId = disclose(eventId);
  const recipient = disclose(recipientPk);
  const tokMetaURI = disclose(tokenMetadataURI);
  const tokPrivCommit = disclose(tokenPrivateMetadataCommit);
  const credAttrRoot = disclose(credentialAttributesRoot);
  assert(!isPaused, "Contract is paused");
  assert(events.member(evId), "Event does not exist");
  const ev = events.lookup(evId);
  assert(is_admin() || ev.organizer == caller_pk(), "Not authorized to mint for this event");
  assert(recipient != holder_pk(ev.organizer), "Cannot mint to yourself");

  mintTokenTo(recipient, evId, ev, tokMetaURI, tokPrivCommit, credAttrRoot, true);
}

// ── Token: Burn ───────────────────────────────────────────────────────────────

// Burn a token. The owner can always burn their own token. Admin or the
// token's own issuer/organizer can also burn it — revocation power, for
// cases where a POAP represents something an institution needs to be able
// to invalidate (e.g. a credential issued in error, or revoked for cause),
// not just a self-service attendance badge.
// Note: totalSupply and event minted counters are not decremented (Compact
// Counter only increments). The token is marked burned on-chain.
//
// Only a SELF-burn frees the (holder, event) claim slot, letting the same
// wallet claim that event again (e.g. they burned by mistake, or want a
// fresh token). An issuer/admin revocation does NOT free it for the
// holder — that's the credential-invalidation case this circuit exists for
// in the first place, and it should stay a real exclusion, not a temporary
// one the holder can immediately undo by re-claiming. The issuer or admin
// can still issue a replacement credential with mintTo (see mintTokenTo).
//
// Every burn (self or revocation) also kills the token's credential leaf
// and resets the tree's root history, so the credential can't be used in
// proveEventAttendance / proveCredentialAttribute against any root, old
// or new. Side effect: other holders' proofs built against a pre-burn root
// fail and must be rebuilt from a fresh path — acceptable since burns are
// rare compared to proofs.
// @circuit   Burns a token: by its holder, or as a revocation by the issuer
//            or the admin.
// @param     tokenId  The token to burn.
// @auth      Token owner (holder pseudonym matches tokenOwner), the token's
//            issuer, or the admin.
// @asserts   Not paused; token exists; not already burned; caller is owner,
//            issuer or admin.
// @writes    burnedTokens[tokenId]; credentials (leaf cleared, history
//            reset); credentialUpdateRequests (pending request removed);
//            eventHolderToken entry removed on a self-burn only.
// @discloses tokenId. Whether it was a self-burn or a revocation is visible
//            too (only a self-burn removes the eventHolderToken entry).
export circuit burn(tokenId: Uint<64>): [] {
  const tId = disclose(tokenId);
  assert(!isPaused, "Contract is paused");
  assert(tokenOwner.member(tId), "Token does not exist");
  assert(!burnedTokens.member(tId), "Token already burned");
  const issuerId = tokenIssuer.lookup(tId);
  const ownerPk = tokenOwner.lookup(tId);
  const isOwner = ownerPk == holder_pk(issuerId);
  assert(isOwner || is_admin() || issuerId == caller_pk(), "Not authorized to burn this token");
  burnedTokens.insert(tId, true);
  credentials.insertIndexDefault(tId);
  credentials.resetHistory();
  // A burned token can't be updated any more: a pending update request is
  // either answered by this burn (the issuer re-issues next with mintTo)
  // or moot (the holder or a revocation burned it).
  if (credentialUpdateRequests.member(tId)) {
    credentialUpdateRequests.remove(tId);
  }
  if (isOwner) {
    const evId = tokenEvent.lookup(tId);
    eventHolderToken.remove(holder_event_key(ownerPk, evId));
  }
}

// ── Token: Credential Update Requests ────────────────────────────────────────
//
// A credential's attributes are fixed at mint time (credentialAttributesRoot
// is hashed into its credential leaf), so changing one — e.g. an identity
// document that was renewed with a new number — means re-issuing the
// credential. These two circuits are the on-chain half of asking for that:
// the holder files a request, the issuer either re-issues (burn + mintTo,
// which also clears the request) or dismisses it.

// Files (or replaces) an update request for one of the caller's tokens.
// payloadCommit is a commitment to the off-chain request the holder sends
// the issuer (e.g. a hash of the encrypted envelope): it binds that
// envelope to the token's holder, so the issuer can tell a genuine request
// from one anybody could post off-chain. Filing again replaces the
// commitment (e.g. to correct a typo before the issuer acts on it).
// @circuit   Holder asks the issuer to re-issue one of their credentials.
// @param     tokenId        The holder's token to update.
// @param     payloadCommit  Commitment to the off-chain request. Non-zero.
// @auth      The token's owner: holder_pk(issuer) rebuilt from local_sk must
//            equal tokenOwner[tokenId].
// @asserts   Not paused; token exists, is not burned; caller is its owner;
//            payloadCommit is non-zero.
// @writes    credentialUpdateRequests[tokenId].
// @discloses tokenId (and with it the holder pseudonym already public in
//            tokenOwner) and payloadCommit. Anyone can see THAT this token's
//            holder asked for an update; nobody but the issuer sees what.
// @private   The secret key.
export circuit requestCredentialUpdate(tokenId: Uint<64>, payloadCommit: Bytes<32>): [] {
  const tId = disclose(tokenId);
  const commit = disclose(payloadCommit);
  assert(!isPaused, "Contract is paused");
  assert(tokenOwner.member(tId), "Token does not exist");
  assert(!burnedTokens.member(tId), "Token burned");
  assert(tokenOwner.lookup(tId) == holder_pk(tokenIssuer.lookup(tId)), "Not the token owner");
  assert(commit != default<Bytes<32>>, "Update request commitment is required");
  credentialUpdateRequests.insert(tId, commit);
}

// Closes a pending update request without re-issuing (e.g. the new data
// couldn't be verified). To accept a request, the issuer burns the token
// and mints the updated credential instead — burn clears the request.
// @circuit   Issuer or admin dismisses a holder's update request.
// @param     tokenId  The token whose request is dismissed.
// @auth      The token's issuer, or the admin.
// @asserts   Not paused; the token has a pending update request; caller is
//            its issuer or the admin.
// @writes    credentialUpdateRequests (removes tokenId).
// @discloses tokenId. Not which of the two roles called.
export circuit dismissCredentialUpdate(tokenId: Uint<64>): [] {
  const tId = disclose(tokenId);
  assert(!isPaused, "Contract is paused");
  assert(credentialUpdateRequests.member(tId), "No pending update request");
  assert(is_admin() || tokenIssuer.lookup(tId) == caller_pk(), "Not authorized to dismiss this request");
  credentialUpdateRequests.remove(tId);
}

// ── Utility ───────────────────────────────────────────────────────────────────

// Global identity: the same value for this wallet across every issuer/admin
// context. Do NOT use this to look up a holder's token in tokenOwner — use
// getHolderPk for that.
// @circuit   Local helper: no proof, no transaction (touches no ledger).
// @returns   derive_pk(local_sk()) — the caller's admin/issuer/verifier key.
// @writes    none.
// @discloses The returned key, to the caller only. Sharing it is the
//            caller's choice; it links everything they do as an organizer.
export circuit getCallerPk(): Bytes<32> {
  return caller_pk();
}

// Per-issuer holder pseudonym for the caller. This is what the caller's
// tokenOwner entries look like for this specific issuer. Share it with an
// organizer so they can mintTo() you, or use it to check your own claims.
// @circuit   Local helper: no proof, no transaction (touches no ledger).
// @param     issuerId  The organizer's public key.
// @returns   The caller's holder pseudonym under that issuer.
// @writes    none.
// @discloses The returned pseudonym, to the caller only.
export circuit getHolderPk(issuerId: Bytes<32>): Bytes<32> {
  return holder_pk(issuerId);
}

// ── Metadata: Private-field Commit / Reveal ──────────────────────────────────
// Same commit/reveal mechanism, reused for both events and individual
// tokens: commit a digest at creation/mint time, anyone who later learns
// the (value, rand) opening can reveal it — knowing the opening IS the
// authorization, no caller-identity check needed.

// Pure helper so off-chain code (the frontend, tests) can compute the exact
// commitment the chain will later check, without reimplementing
// persistentCommit. Works for both event- and token-level commitments —
// value is a digest of whatever private content you want to hide, rand is
// fresh randomness you must keep to reveal later (never reuse rand).
// @circuit   Pure helper, runs locally: no proof, no transaction.
// @param     value  32-byte digest of the content to hide.
// @param     rand   32 fresh random bytes; keep them to reveal later.
// @returns   persistentCommit(value, rand).
// @writes    none.
// @discloses Nothing on-chain: disclose() here only lets the result leave
//            the circuit, on the caller's own machine.
export pure circuit computePrivateMetadataCommit(value: Bytes<32>, rand: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(disclose(value), disclose(rand));
}

// Reveals an event's private metadata. Once revealed, the digest becomes
// permanent public ledger state — commit-reveal hides *when* something
// becomes public, not whether it ever does.
// @circuit   Publishes the opening of an event's privateMetadataCommit.
// @param     eventId  The event.
// @param     value    The committed digest.
// @param     rand     The randomness used in the commitment.
// @auth      None: knowing the opening is the authorization.
// @asserts   Not paused; event exists; it has a non-zero commitment;
//            persistentCommit(value, rand) equals it.
// @writes    eventRevealedMetadata[eventId] = value.
// @discloses eventId, value and rand — revealing is the whole purpose.
//            Irreversible.
export circuit revealPrivateMetadata(eventId: Bytes<32>, value: Bytes<32>, rand: Bytes<32>): [] {
  assert(!isPaused, "Contract is paused");
  const evId = disclose(eventId);
  const val = disclose(value);
  const r = disclose(rand);
  assert(events.member(evId), "Event does not exist");
  const ev = events.lookup(evId);
  assert(ev.privateMetadataCommit != default<Bytes<32>>, "Event has no private metadata");
  const commit = persistentCommit<Bytes<32>>(val, r);
  assert(commit == ev.privateMetadataCommit, "Value does not match the committed metadata");
  eventRevealedMetadata.insert(evId, val);
}

// Reveals a single token's private metadata (e.g. a hidden edition number
// or prize tier assigned at mint time).
// @circuit   Publishes the opening of a token's private-metadata commitment.
// @param     tokenId  The token.
// @param     value    The committed digest.
// @param     rand     The randomness used in the commitment.
// @auth      None: knowing the opening is the authorization.
// @asserts   Not paused; token exists; it has a non-zero commitment;
//            persistentCommit(value, rand) equals it.
// @writes    tokenRevealedMetadata[tokenId] = value.
// @discloses tokenId, value and rand. Irreversible.
export circuit revealPrivateTokenMetadata(tokenId: Uint<64>, value: Bytes<32>, rand: Bytes<32>): [] {
  assert(!isPaused, "Contract is paused");
  const tId = disclose(tokenId);
  const val = disclose(value);
  const r = disclose(rand);
  assert(tokenOwner.member(tId), "Token does not exist");
  assert(tokenPrivateMetadataCommit.member(tId), "Token has no private metadata");
  const storedCommit = tokenPrivateMetadataCommit.lookup(tId);
  assert(storedCommit != default<Bytes<32>>, "Token has no private metadata");
  const commit = persistentCommit<Bytes<32>>(val, r);
  assert(commit == storedCommit, "Value does not match the committed metadata");
  tokenRevealedMetadata.insert(tId, val);
}

// ── Selective Disclosure: Attribute Membership Proofs ────────────────────────
//
// revealPrivateMetadata/revealPrivateTokenMetadata above are "Channel A":
// whoever knows the opening can publish it, and once published it is public
// forever, to everyone. That is the right tool when the organizer WANTS the
// content to eventually become public knowledge.
//
// The circuits below are "Channel B": prove a PREDICATE about a hidden
// attribute (e.g. "this event's country is in the EU") to whoever asked —
// without ever disclosing the attribute's actual value on-chain, and
// without touching eventRevealedMetadata at all. value/rand stay witnesses
// inside the ZK argument — they never appear in the public transcript.
//
// SECURITY-CRITICAL DESIGN NOTE (fixes a real vulnerability from an earlier
// version of this file, confirmed via a security audit that ran the exploit
// against the compiled contract): the "set" being checked against MUST be
// pinned in ledger state via publishDisclosureRequest before anyone proves
// against it. An earlier version let the prover pass `publicSetRoot`
// directly as a circuit argument — but a circuit argument is caller-chosen
// private input, so a prover could satisfy the membership check for ANY
// value by inventing a one-leaf "set" containing exactly that value and
// supplying its own root. The check was self-consistent but vacuous: it
// constrained nothing. Reading the expected root via
// disclosureRequests.lookup() instead — a ledger operation — is what makes
// it something the prover cannot choose. The same reasoning applies to
// binding the disclosure_nullifier to a real, on-chain requestId instead of
// a freely-chosen one (see proveAttributeMembershipOnce).
//
// Depths below are fixed at compile time (Compact has no dynamic-length
// arrays) — this is the same fixed-max-depth tradeoff every production ZK
// Merkle scheme makes, not a limitation specific to this design:
//   ATTR_DEPTH = 8  → up to 256 attribute leaves committed per event
//   SET_DEPTH  = 16 → up to 65536 members in a verifier-published set
//
// Confirmed against compactc 0.31.1: merkleTreePathRoot<#n, T>(path) returns
// MerkleTreeDigest ({ field: Field }), not Bytes<32> — use
// upgradeFromTransient(digest.field) to get a Bytes<32> back for comparison
// against ledger-stored roots.

// Internal leaf hash — binds fieldId AND eventId to the same (value, rand)
// commit scheme already used for privateMetadataCommit, so a single opening
// can't be replayed under a different fieldId, and a root published for one
// event can't be reused to validate proofs about a different event (an
// earlier version omitted eventId here — the one hash in this contract
// without a domain tag, until now). value/rand are NEVER disclosed here:
// this circuit is only ever called from inside another circuit that keeps
// them as witnesses.
circuit attribute_leaf_hash(eventId: Bytes<32>, fieldId: Bytes<32>, value: Bytes<32>, rand: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
           [pad(32, "adasouls:attr-leaf:v1:"), eventId, fieldId, persistentCommit<Bytes<32>>(value, rand)]
           );
}

// Pure off-chain helper (organizer tooling): precompute the exact leaf the
// chain will check, so the organizer can build their attribute Merkle tree
// client-side before calling createEvent. Unlike attribute_leaf_hash, this
// version discloses its own inputs — the organizer already knows their own
// field values; disclose() here only satisfies taint-tracking so the
// result can be used outside a circuit, it does not leak anything new.
//
// NEVER reuse `rand` across attribute leaves for the same event (same
// warning as computePrivateMetadataCommit above, worth repeating here
// specifically because building a whole attribute tree is exactly the
// situation where reusing one rand "for convenience" is most tempting).
// Reusing rand across fields makes leaves for known-value fields
// interlinkable, and for low-entropy domains (country codes, category
// enums) can make the entire tree brute-forceable once any one field is
// revealed via a proof or a leak. Derive per-leaf randomness instead,
// e.g. rand_i = H(masterRand, eventId, fieldId).
// @circuit   Pure helper, runs locally: no proof, no transaction.
// @param     eventId  The event the attribute belongs to.
// @param     fieldId  Identifier of the attribute (e.g. hash of its name).
// @param     value    The attribute's value, encoded to 32 bytes.
// @param     rand     32 fresh random bytes, unique per leaf.
// @returns   The leaf to place in the event's attribute tree.
// @writes    none.
// @discloses Nothing on-chain (see computePrivateMetadataCommit).
export pure circuit computeAttributeLeaf(eventId: Bytes<32>, fieldId: Bytes<32>, value: Bytes<32>, rand: Bytes<32>): Bytes<32> {
  return attribute_leaf_hash(disclose(eventId), disclose(fieldId), disclose(value), disclose(rand));
}

// Derives a requestId from the verifier's own identity + a label they
// choose, the same way createEvent's caller-chosen eventId would ideally
// be scoped (see the eventId-squatting finding elsewhere) — this prevents
// a third party from squatting a request id a verifier is about to
// publish, or colliding with one another verifier already used, without
// requiring any coordination beyond "pick your own label".
circuit disclosure_request_key(verifier: Bytes<32>, label: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
           [pad(32, "adasouls:disclosure-req:v1:"), verifier, label]
           );
}

// Publishes a disclosure request: "does event `eventId`'s `fieldId`
// attribute belong to the set rooted at `setRoot`?" Callable by anyone who
// wants to ask (not just admin/organizer — e.g. a third-party verifier
// checking eligibility for something of their own). Returns the derived
// requestId, which the verifier hands to whoever they want an answer from
// (QR code, link, etc.) alongside setRoot's opening (the actual set
// members) so the holder can build a real membership path.
//
// PRIVACY NOTE for verifiers: a set with very few members — a singleton
// set especially — makes "membership" equivalent to full disclosure of
// the value. The contract has no way to enforce a minimum set size from a
// root alone; that's a property of what the verifier chooses to publish,
// not something provable on-chain. Publish sets large/generic enough that
// membership doesn't narrow the holder's actual value down to one option,
// if the holder's privacy is meant to survive answering.
//
// `recipient` addresses the request to one holder (their getHolderPk under
// this event's issuer, which the holder hands to the verifier and which is
// already public in tokenOwner). Pass an all-zero Bytes<32> for an open
// request. An addressed request is public like everything else here: anyone
// can see WHO was asked, and a successful answer shows that this pseudonym
// answered. What stays hidden is the attribute's value. The recipient is
// not checked against tokenOwner at publish time — a request addressed to a
// pseudonym with no live credential simply can never be answered.
// @circuit   A verifier pins a question on-chain for holders to answer.
// @param     label    Verifier-chosen label, hashed into the request id.
// @param     eventId  The event the question is about.
// @param     fieldId  The attribute asked about (zero for ownership-only).
// @param     setRoot  Merkle root of the accepted values (zero for
//                     ownership-only).
// @param     recipient  Holder pseudonym the request is addressed to, or
//                       zero for an open request. Required (non-zero) for a
//                       request meant for proveCredentialAttribute.
// @returns   The derived requestId.
// @auth      Anyone.
// @asserts   Not paused; event exists; request id not already used.
// @writes    disclosureRequests[requestId].
// @discloses Every argument, the caller's public key (stored as verifier)
//            and the request id — a request is public by definition.
export circuit publishDisclosureRequest(
                 label: Bytes<32>,
                 eventId: Bytes<32>,
                 fieldId: Bytes<32>,
                 setRoot: Bytes<32>,
                 recipient: Bytes<32>
                 ): Bytes<32> {
  assert(!isPaused, "Contract is paused");
  const lbl = disclose(label);
  const evId = disclose(eventId);
  const fId = disclose(fieldId);
  const sRoot = disclose(setRoot);
  const rcpt = disclose(recipient);
  assert(events.member(evId), "Event does not exist");
  const verifier = caller_pk();
  const rid = disclose(disclosure_request_key(verifier, lbl));
  assert(!disclosureRequests.member(rid), "Request already published");
  const req = DisclosureRequest { verifier: verifier, eventId: evId, fieldId: fId, setRoot: sRoot, recipient: rcpt };
  disclosureRequests.insert(rid, req);
  return rid;
}

// Proves that a hidden attribute matches a previously-published
// DisclosureRequest — i.e. that the event/field/set the request pinned
// really does hold for a `value` the prover knows an opening for. Signals
// success purely by not throwing (same convention as revealPrivateMetadata
// etc.) — every failure path here is an assert, so a `Boolean` return
// could only ever observably be `true`; typing it that way invited exactly
// that dead-code assumption downstream (see proveAttributeMembershipOnce's
// history). Never inserts anything into ledger state. Per the Compact
// circuit classification already used elsewhere in this contract
// (getCallerPk/getHolderPk are witness-only and need no proof; anything
// that reads ledger state like `events` becomes a ProvableCircuit), this
// circuit DOES require proof generation and a submitted transaction, same
// as revealPrivateMetadata — it does not mutate state, but it still needs a
// ZK argument because a third party must be able to trust the result
// without trusting the caller.
// @circuit   Proves an EVENT-level private attribute is in the verifier's
//            set. Callable by whoever knows the attribute's opening
//            (normally the organizer); holding a token is not required.
//            The request's recipient is ignored here: an event attribute is
//            not a holder's data, so there is no holder to address.
// @param     requestId          A published disclosure request.
// @param     value              The attribute's hidden value.
// @param     rand               The randomness of its commitment.
// @param     attributePath      Merkle path of the attribute leaf in the
//                               event's attribute tree (depth 8).
// @param     setMembershipPath  Merkle path of value in the verifier's set
//                               (depth 16).
// @auth      None: knowing a valid opening is the authorization.
// @asserts   Request exists; its event exists and has an attribute root;
//            the leaf rebuilt from (event, field, value, rand) matches
//            attributePath and hashes up to the event's root; value matches
//            setMembershipPath and hashes up to the request's setRoot.
// @writes    none. Also works while the contract is paused.
// @discloses requestId only.
// @private   value, rand and both Merkle paths.
export circuit proveAttributeMembership(
                 requestId: Bytes<32>,
                 value: Bytes<32>,
                 rand: Bytes<32>,
                 attributePath: MerkleTreePath<8, Bytes<32>>,
                 setMembershipPath: MerkleTreePath<16, Bytes<32>>
                 ): [] {
  const rid = disclose(requestId);
  assert(disclosureRequests.member(rid), "Unknown disclosure request");
  const req = disclosureRequests.lookup(rid);
  assert(events.member(req.eventId), "Event does not exist");
  const ev = events.lookup(req.eventId);
  assert(ev.privateAttributesRoot != default<Bytes<32>>, "Event has no committed attributes");

  // 1. The hidden (value, rand) opening really is one of this event's
  //    committed attribute leaves — value/rand never leave the circuit.
  // merkleTreePathRoot returns MerkleTreeDigest ({ field: Field }), not
  // Bytes<32> — upgradeFromTransient converts its .field back to Bytes<32>
  // so it can be compared against the Bytes<32> root stored in EventRecord.
  const leaf = attribute_leaf_hash(req.eventId, req.fieldId, value, rand);
  assert(attributePath.leaf == leaf, "Path does not match the recomputed leaf");
  const attrRoot = upgradeFromTransient(merkleTreePathRoot<8, Bytes<32>>(attributePath).field);
  assert(attrRoot == ev.privateAttributesRoot, "Attribute not committed for this event");

  // 2. The SAME hidden value is also a member of the set PINNED by the
  //    published request (req.setRoot — ledger state, not a circuit
  //    argument) — again without disclosing which member it is.
  assert(setMembershipPath.leaf == value, "Set path does not match the hidden value");
  const computedSetRoot = upgradeFromTransient(merkleTreePathRoot<16, Bytes<32>>(setMembershipPath).field);
  assert(computedSetRoot == req.setRoot, "Value is not a member of the requested set");
}

// Nullifier keyed on the (real, on-chain, unforgeable) requestId alone —
// deterministic per (wallet, request), so this wallet always produces the
// same nullifier for the same request (blocking replay) but an
// unrelated/different request produces a different, unlinkable nullifier
// (same per-context pseudonym trick as holder_pk).
circuit disclosure_nullifier(requestId: Bytes<32>): Bytes<32> {
  return disclose(persistentHash<Vector<3, Bytes<32>>>(
           [pad(32, "adasouls:disclosure:v2:"), local_sk(), requestId]
           ));
}

// Single-use variant of proveAttributeMembership: same predicate check,
// plus a nullifier recorded in usedDisclosures so this (wallet, request)
// combination cannot be redeemed twice. Only use this when a disclosure
// must provably happen at most once (e.g. redeeming a perk) — it costs a
// state write and reveals (only to someone who already knows requestId,
// i.e. the verifier who published it) that SOME wallet redeemed it. Most
// "just answer the question" flows should call proveAttributeMembership
// directly instead and skip this entirely.
// @circuit   proveAttributeMembership, at most once per (wallet, request).
// @param     (same as proveAttributeMembership)
// @auth      None beyond knowing a valid opening.
// @asserts   Not paused; everything proveAttributeMembership asserts; this
//            wallet's nullifier for the request is not yet in
//            usedDisclosures.
// @writes    usedDisclosures (adds the nullifier).
// @discloses requestId, and the nullifier
//            H("adasouls:disclosure:v2:", local_sk, requestId) — needed to
//            block replays; it reveals neither the key nor the wallet.
// @private   value, rand, both Merkle paths, the secret key.
export circuit proveAttributeMembershipOnce(
                 requestId: Bytes<32>,
                 value: Bytes<32>,
                 rand: Bytes<32>,
                 attributePath: MerkleTreePath<8, Bytes<32>>,
                 setMembershipPath: MerkleTreePath<16, Bytes<32>>
                 ): [] {
  assert(!isPaused, "Contract is paused");
  // proveAttributeMembership signals success by not throwing — no boolean
  // to check, it either aborts the whole transaction or it holds.
  proveAttributeMembership(requestId, value, rand, attributePath, setMembershipPath);
  const n = disclosure_nullifier(requestId);
  assert(!usedDisclosures.member(n), "Disclosure already redeemed for this request");
  usedDisclosures.insert(n);
}

// ── Ownership Proofs ─────────────────────────────────────────────────────────
//
// Two flavours, both answering a verifier's published DisclosureRequest
// (publishDisclosureRequest) so the proof is scoped to that verifier's
// event and fresh for that request — a proof with no request would only
// show "someone, at some point, owned token N", which no verifier can act
// on. For ownership-only requests fieldId/setRoot are ignored (publish
// them as all-zero).
//
//   proveTokenOwnership   — PUBLIC: reveals the tokenId (and so the holder
//                           pseudonym). The basic "caller owns a token".
//   proveEventAttendance  — ANONYMOUS: "I own SOME live token of this
//                           event", via the credentials tree. Reveals only
//                           requestId, eventId and a tree root.
//   proveCredentialAttribute — a predicate over the holder's OWN private
//                           attributes (set by mintTo), value kept hidden.
//
// Like proveAttributeMembership, all three signal success by not throwing
// and write nothing: a verifier checks for a successful transaction calling
// the circuit with their requestId. That also means a holder can relay an
// OPEN request to someone else who holds the same POAP — inherent to any
// stateless proof; publish one request per verification session.
//
// An ADDRESSED request (req.recipient non-zero) closes that gap: all three
// circuits then also require the prover's own holder pseudonym to equal
// the recipient, so only that one holder can answer. The price is
// anonymity — the request names the pseudonym publicly — so the two
// "anonymous" circuits then hide only what they prove ABOUT the credential
// (which token, which attribute value), not who answered.
//
//   proveTokenOwnership, proveEventAttendance — open or addressed, the
//                           verifier's choice.
//   proveCredentialAttribute — addressed ONLY. A holder's private data is
//                           asked of one person; an open request is
//                           rejected.

// Fails unless the request is open or `holderPk` (the prover's pseudonym,
// always rebuilt from local_sk by the caller of this helper — never a
// circuit argument) is the holder it is addressed to.
circuit assert_addressed_to(req: DisclosureRequest, holderPk: Bytes<32>): [] {
  assert(req.recipient == default<Bytes<32>> || req.recipient == holderPk,
         "Request is addressed to another holder"
         );
}

// Pure off-chain helper (wallet tooling): the credential leaf the wallet
// needs to look up its own Merkle path, e.g.
// ledger.credentials.pathForLeaf(tokenId, computeCredentialLeaf(...)).
// holderPk here is getHolderPk(issuerId) — already public in tokenOwner.
// @circuit   Pure helper, runs locally: no proof, no transaction.
// @param     eventId       The token's event.
// @param     holderPk      The holder's pseudonym under the event's issuer.
// @param     credAttrRoot  The credential's private attribute root, or zero.
// @returns   The credential leaf stored in `credentials`.
// @writes    none.
// @discloses Nothing on-chain (see computePrivateMetadataCommit).
export pure circuit computeCredentialLeaf(eventId: Bytes<32>, holderPk: Bytes<32>, credAttrRoot: Bytes<32>): Bytes<32> {
  return credential_leaf(disclose(eventId), disclose(holderPk), disclose(credAttrRoot));
}

// Pure off-chain helper (organizer tooling): one leaf of a recipient's
// private attribute tree, whose root goes into mintTo's
// credentialAttributesRoot. Same rand rules as computeAttributeLeaf: never
// reuse rand across leaves or credentials.
// @circuit   Pure helper, runs locally: no proof, no transaction.
// @param     fieldId  Identifier of the attribute.
// @param     value    The attribute's value, encoded to 32 bytes.
// @param     rand     32 fresh random bytes, unique per leaf.
// @returns   The leaf to place in the recipient's attribute tree.
// @writes    none.
// @discloses Nothing on-chain (see computePrivateMetadataCommit).
export pure circuit computeCredentialAttrLeaf(fieldId: Bytes<32>, value: Bytes<32>, rand: Bytes<32>): Bytes<32> {
  return credential_attr_leaf(disclose(fieldId), disclose(value), disclose(rand));
}

// Pure off-chain helper (issuer, holder and verifier tooling): the
// attribute value that ties a credential to one identity document, so a
// verifier who has checked the person's document can make sure the
// credential being proven is theirs and not a friend's (credential
// lending). The issuer stores it as an ordinary credential attribute
// (computeCredentialAttrLeaf); a credential may carry several, one per
// document, each under its own fieldId. The verifier rebuilds it from the
// document they checked plus the salt the holder gives them, and publishes
// an addressed request whose set is just that one value.
//
// The inputs are canonical text, right-padded with zero bytes to 32 —
// agreeing on the normalization is the callers' job (country: ISO 3166-1
// alpha-3, e.g. "ARG"; docType: e.g. "national_id", "passport"; number:
// upper-case, no spaces or separators). The salt is what keeps a request's
// public setRoot from revealing the document: without it, document numbers
// are few enough to brute-force from the root. Use a fresh random salt per
// document per credential; the holder shares it only with verifiers.
// @circuit   Pure helper, runs locally: no proof, no transaction.
// @param     country  Issuing country, ISO 3166-1 alpha-3, padded.
// @param     docType  Document type, padded.
// @param     number   Normalized document number, padded.
// @param     salt     32 random bytes. Non-zero.
// @returns   The attribute value to store for this document.
// @writes    none.
// @discloses Nothing on-chain (see computePrivateMetadataCommit).
export pure circuit computeIdentityValue(country: Bytes<32>, docType: Bytes<32>, number: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  assert(disclose(salt) != default<Bytes<32>>, "Identity salt is required");
  return persistentHash<Vector<5, Bytes<32>>>(
           [pad(32, "velum:identity:v1:"), disclose(country), disclose(docType), disclose(number), disclose(salt)]
           );
}

// Proves the caller owns live token `tokenId` of the request's event.
// Burned tokens (self-burn or issuer/admin revocation) fail.
// @circuit   PUBLIC ownership proof: "I own token N of your event".
// @param     requestId  A published disclosure request.
// @param     tokenId    The token being proven.
// @auth      The token's owner: holder_pk(issuer) rebuilt from local_sk must
//            equal tokenOwner[tokenId].
// @asserts   Request exists; token exists, is not burned, belongs to the
//            request's event; caller's pseudonym is its owner and, for an
//            addressed request, is the recipient.
// @writes    none. Also works while the contract is paused.
// @discloses requestId and tokenId — and with tokenId, the holder pseudonym
//            already public in tokenOwner. Use proveEventAttendance when
//            that link must stay hidden.
// @private   The secret key.
export circuit proveTokenOwnership(requestId: Bytes<32>, tokenId: Uint<64>): [] {
  const rid = disclose(requestId);
  const tId = disclose(tokenId);
  assert(disclosureRequests.member(rid), "Unknown disclosure request");
  const req = disclosureRequests.lookup(rid);
  assert(tokenOwner.member(tId), "Unknown token");
  assert(!burnedTokens.member(tId), "Token burned");
  assert(tokenEvent.lookup(tId) == req.eventId, "Token is not for the requested event");
  const ownerPk = holder_pk(tokenIssuer.lookup(tId));
  assert(tokenOwner.lookup(tId) == ownerPk, "Not the owner");
  assert_addressed_to(req, ownerPk);
}

// Proves the caller owns SOME live token of the request's event, without
// revealing which. The anonymity set is every live credential of that
// event — small events mean small sets. credAttrRoot is the holder's own
// attribute root (all-zero for claim()ed tokens), kept private.
// Build credPath against the LATEST root: the root in the transcript tells
// an observer which tree version the proof used.
// Answering an ADDRESSED request is not anonymous: only the recipient can,
// so a successful call shows that pseudonym answered (the token id still
// isn't in the transcript).
// @circuit   ANONYMOUS ownership proof: "I own some live token of your
//            event".
// @param     requestId     A published disclosure request.
// @param     credAttrRoot  The caller's credential attribute root (zero for
//                          claim()ed tokens).
// @param     credPath      Merkle path of the caller's credential leaf in
//                          `credentials` (depth 20).
// @auth      The holder: the leaf is rebuilt from local_sk, so only the
//            holder's key produces a leaf that is in the tree.
// @asserts   Request and its event exist; for an addressed request, the
//            caller's pseudonym is the recipient; the leaf rebuilt from
//            (event, holder pseudonym, credAttrRoot) matches credPath; the
//            path's root is a current or historic root of `credentials`.
// @writes    none. Also works while the contract is paused.
// @discloses requestId, and the credentials-tree root the path resolves to
//            — needed for the on-chain root check; it is the same for every
//            holder using that tree version.
// @private   The token id, the credential leaf, credAttrRoot and the secret
//            key. The holder pseudonym too, for an open request.
export circuit proveEventAttendance(
                 requestId: Bytes<32>,
                 credAttrRoot: Bytes<32>,
                 credPath: MerkleTreePath<20, Bytes<32>>
                 ): [] {
  const rid = disclose(requestId);
  assert(disclosureRequests.member(rid), "Unknown disclosure request");
  const req = disclosureRequests.lookup(rid);
  assert(events.member(req.eventId), "Event does not exist");
  const ev = events.lookup(req.eventId);
  const holderPk = holder_secret_pk(ev.organizer);
  assert_addressed_to(req, holderPk);
  const leaf = credential_leaf(req.eventId, holderPk, credAttrRoot);
  assert(credPath.leaf == leaf, "Path does not match this holder's credential");
  assert(credentials.checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(credPath))),
         "Credential not in tree");
}

// Proves the caller is the holder the request is ADDRESSED to, owns a live
// token of the request's event, AND that the private attribute req.fieldId
// committed in THAT credential (via mintTo's credentialAttributesRoot) is a
// member of the set pinned at req.setRoot — revealing neither the token nor
// the value. Who answered is public: the request names its recipient.
//
// Open requests are rejected. With one, any holder of the event whose own
// attribute satisfied the set could answer, so the person a verifier is
// actually dealing with could hand the request to someone else who
// qualifies; the proof would say nothing about THEM.
// Same pinned-set reasoning as proveAttributeMembership. The attribute
// root is never an input: it's recomputed from attrPath, so the only way
// to satisfy the credential-leaf check is with openings the organizer
// actually committed for this holder.
// @circuit   Addressed proof of a predicate on one of the recipient's own
//            private attributes, without revealing its value.
// @param     requestId          A published disclosure request.
// @param     value              The attribute's hidden value.
// @param     rand               The randomness of its commitment.
// @param     attributePath      Merkle path of the attribute leaf in the
//                               credential's attribute tree (depth 8).
// @param     setMembershipPath  Merkle path of value in the verifier's set
//                               (depth 16).
// @param     credPath           Merkle path of the credential leaf in
//                               `credentials` (depth 20).
// @auth      The request's recipient only: the pseudonym rebuilt from
//            local_sk must equal req.recipient.
// @asserts   Request and its event exist; the request is addressed, and to
//            the caller's pseudonym; the attribute leaf matches
//            attributePath; the credential leaf rebuilt from the resulting
//            root matches credPath, whose root is known to `credentials`;
//            value matches setMembershipPath and hashes up to the request's
//            setRoot.
// @writes    none. Also works while the contract is paused.
// @discloses requestId and the credentials-tree root (see
//            proveEventAttendance). Through the request, that its recipient
//            answered.
// @private   value, rand, all three Merkle paths, the token id and the
//            secret key.
export circuit proveCredentialAttribute(
                 requestId: Bytes<32>,
                 value: Bytes<32>,
                 rand: Bytes<32>,
                 attributePath: MerkleTreePath<8, Bytes<32>>,
                 setMembershipPath: MerkleTreePath<16, Bytes<32>>,
                 credPath: MerkleTreePath<20, Bytes<32>>
                 ): [] {
  const rid = disclose(requestId);
  assert(disclosureRequests.member(rid), "Unknown disclosure request");
  const req = disclosureRequests.lookup(rid);
  assert(events.member(req.eventId), "Event does not exist");
  const ev = events.lookup(req.eventId);
  assert(req.recipient != default<Bytes<32>>, "Request must be addressed to a holder");
  const holderPk = holder_secret_pk(ev.organizer);
  assert_addressed_to(req, holderPk);

  // 1. (value, rand) opens one of this credential's attribute leaves.
  assert(attributePath.leaf == credential_attr_leaf(req.fieldId, value, rand),
         "Path does not match the recomputed leaf");
  const credAttrRoot = upgradeFromTransient(merkleTreePathRoot<8, Bytes<32>>(attributePath).field);

  // 2. That attribute root belongs to a live credential of the caller.
  const leaf = credential_leaf(req.eventId, holderPk, credAttrRoot);
  assert(credPath.leaf == leaf, "Path does not match this holder's credential");
  assert(credentials.checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(credPath))),
         "Credential not in tree");

  // 3. The same hidden value is in the verifier's pinned set.
  assert(setMembershipPath.leaf == value, "Set path does not match the hidden value");
  const computedSetRoot = upgradeFromTransient(merkleTreePathRoot<16, Bytes<32>>(setMembershipPath).field);
  assert(computedSetRoot == req.setRoot, "Value is not a member of the requested set");
}
