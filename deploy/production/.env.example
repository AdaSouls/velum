# Copy to deploy/production/.env (gitignored) and fill in. Read by docker compose.

# ── Public endpoint ──────────────────────────────────────────────────────────
# DNS A (and AAAA, if the server has IPv6) record must point here before first start.
API_DOMAIN=api.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.com

# ── Frontend (Vercel) ────────────────────────────────────────────────────────
# Origins allowed to call the indexer API cross-origin. Comma-separated, exact match, no "*".
# Include the production domain and, if you use it, the stable *.vercel.app domain.
CORS_ALLOWED_ORIGINS=https://example.com,https://velum.vercel.app
# Single origin allowed by the IPFS proxy (its CORS handling takes exactly one).
FRONTEND_ORIGIN=https://example.com

# ── Midnight ─────────────────────────────────────────────────────────────────
# From deployments/<network>.md after running scripts/deploy.ts. Must match the compiled
# contract baked into the indexer image (contracts/src/managed/poap/contract).
CONTRACT_ADDRESS=
MIDNIGHT_NETWORK_ID=preprod
# Midnight's public indexer was decommissioned on 2026-10-09; Blockfrost serves it now. Create a
# "Midnight Preprod" (or "Midnight Mainnet") project at blockfrost.io and paste its project id.
# It starts with nightpreprod / nightmainnet and must match MIDNIGHT_NETWORK_ID. Used by the
# indexer, and by Caddy for the /midnight/indexer proxy the frontend talks to. Keep it secret.
BLOCKFROST_PROJECT_ID=

# ── Database ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Optional: IPFS pinning proxy (poap-frontend/server) ──────────────────────
# Uncomment to enable. FRONTEND_SERVER_DIR is a path on THIS host to poap-frontend/server.
# PINATA_JWT is the real secret — scoped to Files (read+write) and Gateways (read), never admin.
#COMPOSE_PROFILES=ipfs
#FRONTEND_SERVER_DIR=/opt/poap-frontend/server
#PINATA_JWT=

# ── Optional: a second network (mainnet) on this same server ─────────────────
# Routed by host name through the same Caddy, so no extra public port. Needs its own DNS record,
# Blockfrost project (Midnight Mainnet) and contract address (deployments/mainnet.md). Runs the
# same indexer image and serves the same ZK artifacts, so the mainnet contract must be the same
# build as the one above. Enable with COMPOSE_PROFILES=mainnet (or ipfs,mainnet).
#MAINNET_API_DOMAIN=mainnet-api.example.com
#MAINNET_BLOCKFROST_PROJECT_ID=
#MAINNET_CONTRACT_ADDRESS=
#MAINNET_CORS_ALLOWED_ORIGINS=https://mainnet.example.com
#MAINNET_FRONTEND_ORIGIN=https://mainnet.example.com
