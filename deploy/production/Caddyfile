# Velum API host. Caddy obtains and renews the TLS certificate for {$API_DOMAIN} automatically
# (the domain's A/AAAA record must already point at this server, and ports 80/443 must be open).
{
	email {$ACME_EMAIL}
}

# Everything one network's API host serves. Arguments: the Midnight network, its Blockfrost
# project id, the indexer upstream and the IPFS proxy upstream.
(velum_api) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# ZK artifacts (prover/verifier keys + zkir) for the deployed contract, fetched by the
	# frontend's FetchZkConfigProvider as <base>/keys/<circuit>.prover etc. with
	# base = https://{$API_DOMAIN}/zk/poap. Public data by design (the verifier keys are on-chain
	# anyway), so a wildcard CORS origin is fine — no credentials are ever involved.
	handle_path /zk/* {
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=3600"
		root * /srv/zk
		file_server
	}

	# Midnight's indexer (GraphQL), for the frontend: contract reads, transaction watching and the
	# public verify page. It is served by Blockfrost, which needs a project id; proxying it here
	# keeps that id out of the browser bundle. Public chain data and no credentials, so a wildcard
	# CORS origin is fine.
	#   POST https://{$API_DOMAIN}/midnight/indexer      queries
	#   WSS  https://{$API_DOMAIN}/midnight/indexer/ws   subscriptions
	@mnindexer path /midnight/indexer /midnight/indexer/ws
	handle @mnindexer {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Headers "content-type"
		header Access-Control-Allow-Methods "POST, GET, OPTIONS"
		header Access-Control-Max-Age "86400"

		@preflight method OPTIONS
		respond @preflight 204

		@ws path /midnight/indexer/ws
		rewrite @ws /api/v0/ws?project_id={args[1]}
		@http path /midnight/indexer
		rewrite @http /api/v0?project_id={args[1]}

		reverse_proxy https://midnight-{args[0]}.blockfrost.io {
			header_up Host {upstream_hostport}
			header_up -Origin
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Allow-Methods
		}
	}

	# IPFS pinning proxy from poap-frontend/server (holds the Pinata secret server-side). Besides
	# /api/ipfs/* it serves the encrypted wallet backups, credential delivery, disclosure sets and credential update requests,
	# all fetched by the frontend from REACT_APP_IPFS_API_URL.
	@ipfs path /api/ipfs/* /api/backup /api/backup/* /api/credential-delivery /api/credential-delivery/* /api/disclosure-sets /api/disclosure-sets/* /api/credential-update /api/credential-update/*
	handle @ipfs {
		reverse_proxy {args[3]}
	}

	# Everything else: the Velum indexer API (/health, /api/events, /api/tokens,
	# /api/disclosure-requests). CORS is handled by the indexer itself (CORS_ALLOWED_ORIGINS).
	handle {
		reverse_proxy {args[2]}
	}
}

{$API_DOMAIN} {
	import velum_api {$MIDNIGHT_NETWORK_ID} {$BLOCKFROST_PROJECT_ID} indexer:3001 ipfs-proxy:4000
}

# Optional second network on the same server (compose profile "mainnet"): same image, same ZK
# artifacts, its own database and contract address. Routed by host name, so it needs no extra
# public port. While MAINNET_API_DOMAIN is unset this block listens on a port nothing publishes.
{$MAINNET_API_DOMAIN::8081} {
	import velum_api mainnet {$MAINNET_BLOCKFROST_PROJECT_ID:unset} indexer-mainnet:3001 ipfs-proxy-mainnet:4000
}
