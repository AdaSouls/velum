# Copy this file and fill in real values. Never commit the copy — .gitignore already covers
# .env, .env.local and .env.<network>.local (the files these scripts actually read/write).
#
# This repo has two independent consumers of env vars — they don't share a loader:
#   1. scripts/deploy.ts and scripts/wallet-info.ts read straight from process.env (no dotenv).
#      Export these in your shell, or put them in a root-level .env.<network>.local and source it.
#   2. indexer/src/config.ts uses `dotenv/config`, which auto-loads a .env file from ITS OWN
#      cwd — i.e. indexer/.env when the indexer is run via `npm run start` inside indexer/.

# ---------------------------------------------------------------------------
# scripts/deploy.ts & scripts/wallet-info.ts (deployer wallet + target network)
# ---------------------------------------------------------------------------

# Which network to deploy/derive a wallet against. Unset or "undeployed" (default) targets the
# local devnet.yml stack and uses the pre-funded genesis wallet — no seed needed in that case.
# Any other value (preprod | preview | qanet) requires MN_TEST_WALLET_SEED below, funded via that
# network's faucet first (run wallet-info.ts to get the address to fund).
MN_TEST_ENVIRONMENT=preprod

# Hex secret key for the deployer wallet on the target network above (32 bytes for a raw seed
# like GENESIS_SEED in deploy.ts; 64 bytes when derived from a BIP-39 mnemonic via
# mnemonicToSeedSync, as scripts/wallet-info.ts does — both lengths work, deploy.ts passes
# whatever you give it straight through to MidnightWalletProvider.build()). Required whenever
# MN_TEST_ENVIRONMENT is not "undeployed" — there is no genesis wallet outside local devnet.
# Get one (and the address to fund) via: MN_TEST_ENVIRONMENT=preprod npx tsx scripts/wallet-info.ts
# NEVER commit a real value here. Treat it like a private key — it controls real funds.
MN_TEST_WALLET_SEED=

# Alternative to MN_TEST_WALLET_SEED for scripts/wallet-info.ts only: a 24-word BIP-39 mnemonic to
# re-derive the same seed/address from (e.g. to confirm an address after importing into Lace).
# Leave unset when you already have MN_TEST_WALLET_SEED.
MN_TEST_WALLET_MNEMONIC=

# ---------------------------------------------------------------------------
# indexer/ (copy the block below into indexer/.env when running the indexer standalone)
# ---------------------------------------------------------------------------

# Required — indexer/src/config.ts throws if unset. deploy.ts prints/saves this after a successful
# deployment (docs/deployment.<network>.md and .env.<network>.local's CONTRACT_ADDRESS).
CONTRACT_ADDRESS=

# Must match whichever network indexerWs/indexerHttp below actually point at — affects address
# encoding/decoding and ledger state parsing.
MIDNIGHT_NETWORK_ID=undeployed

# devnet.yml's indexer-standalone service by default. Point at the real preprod/preview/qanet
# indexer endpoints when MIDNIGHT_NETWORK_ID is not "undeployed".
MIDNIGHT_INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws
MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql

# The indexer app's own business-data Postgres (devnet.yml's poap-pg service — unrelated to the
# Midnight SDK generation, just merged into the same compose file for convenience).
DATABASE_URL=postgresql://poap:poap@localhost:5434/poap_indexer

PORT=3001

# Comma-separated allowlist of origins allowed to call the indexer API cross-origin, e.g.
# "http://localhost:5173,https://staging.adasouls.io". Unset (the default) disables CORS
# entirely — same-origin only. Never set this to "*".
CORS_ALLOWED_ORIGINS=

# Only set this if the compiled contract genuinely lives somewhere other than the sibling
# contracts/ workspace (defaults to contracts/src/managed/poap/contract/index.js). Match the
# filesystem's actual casing exactly — see the comment on DEFAULT_CONTRACT_MODULE_PATH in
# indexer/src/config.ts for why a casing mismatch silently breaks things.
CONTRACT_MODULE_PATH=
